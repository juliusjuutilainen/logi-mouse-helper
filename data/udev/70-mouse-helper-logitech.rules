# Logitech G Pro Superlight family hidraw access for desktop users.
# MODE is intentionally limited to the supported product IDs below. TAG+="uaccess"
# covers systemd-logind desktop sessions; MODE keeps the helper working on
# lightweight XFCE sessions where logind ACLs are not applied.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c547", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c094", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c54d", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c09b", MODE="0666", TAG+="uaccess"
